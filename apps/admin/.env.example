# Directus 后台（headless CMS）环境变量示例
# 由根目录 docker-compose.yml 的 directus 服务读取；复制为 .env 使用。

# 密钥（务必改成随机值）
DIRECTUS_KEY=change-me-key
DIRECTUS_SECRET=change-me-secret

# 初始管理员
DIRECTUS_ADMIN_EMAIL=admin@worldknowledge.org
DIRECTUS_ADMIN_PASSWORD=password

# 数据库（MySQL）
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=world_knowledge
DB_USER=root
DB_PASSWORD=password
