# WorldKnowledge API 环境变量示例（复制为 .env 使用）

# 项目
PROJECT_NAME=WorldKnowledge API
API_V1_PREFIX=/v1

# 数据库（MySQL 8，表结构由 Directus 建并管理）
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/world_knowledge

# Directus（headless CMS）
DIRECTUS_URL=http://localhost:8055
DIRECTUS_KEY=
DIRECTUS_SECRET=

# 搜索（后期接入 Meilisearch）
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# 图谱（后期接入 Neo4j）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 跨域（逗号分隔：门户 :3000、后台 Directus :8055）
CORS_ORIGINS=http://localhost:3000,http://localhost:8055
