# 复制为 .env 使用（docker compose 会自动读取）
# 数据库
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=world_knowledge

# Directus 后台
DIRECTUS_KEY=change-me-key
DIRECTUS_SECRET=change-me-secret
DIRECTUS_ADMIN_EMAIL=admin@worldknowledge.org
DIRECTUS_ADMIN_PASSWORD=password

# Meilisearch
MEILI_MASTER_KEY=change-me-master-key

# 说明：web 容器内访问 API / Directus 的地址在 docker-compose.yml 中通过
# NEXT_PUBLIC_API_BASE_URL / NEXT_PUBLIC_DIRECTUS_URL 注入为 compose 服务名
# （http://api:8000、http://directus:8055）；宿主机浏览器则用 localhost:8000 / localhost:8055。
